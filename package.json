{
  "name": "zero-assistant",
  "version": "0.1.0",
  "description": "صوت المساعد الصوتي الشخصي",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.zero.assistant",
    "productName": "صوت المساعد الصوتي",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^25.1.4"
  }
}
